{
  "name": "@weekspan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client. Chrome/Edge only \u2014 File System Access API.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node scripts/shots.mjs",
    "build:single": "node scripts/build-singlefile.mjs",
    "probe:file": "node scripts/probe-singlefile.mjs",
    "probe:handles": "node scripts/probe-handle-persistence.mjs",
    "verify": "npm run typecheck && npm run test && npm run build:single && npm run probe:file && npm run probe:project && npm run probe:undo",
    "probe:project": "node scripts/probe-project-view.mjs",
    "probe:undo": "node scripts/probe-undo.mjs"
  },
  "dependencies": {
    "@weekspan/weekspan-core": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.44.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
